# 复制本文件为 .streamlit/secrets.toml 并填入真实值（该文件已被 .gitignore 排除）。
# 线上部署：把同样内容粘贴到 Streamlit Cloud → App → Settings → Secrets。

[auth]
cookie_name = "music_personality_app"
# 随便一串足够长的随机字符串，可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
cookie_key = "REPLACE_WITH_RANDOM_SECRET"
# 登录 Cookie 有效期（天）
cookie_expiry_days = 7

# 预置账号（可配置多个，复制这一段改用户名即可）
# 密码要求：8~20 位，含大小写字母、数字、特殊字符；
# 也可直接填 bcrypt 哈希（以 $2b$ 开头），程序会自动识别、不重复哈希。
# roles 决定能看到哪些页面：admin 可进「👤 用户管理」，user 只能用其余七个页面。
# 请务必给这个预置账号 admin 角色——它同时是 MySQL 连不上时的登录兜底。
[auth.usernames.admin]
email = "you@example.com"
first_name = "Admin"
last_name = "User"
password = "REPLACE_WITH_STRONG_PASSWORD"
roles = ["admin"]

# 用户数据存哪。**缺省是 json**，即 data/users.json（云端与 exe 场景就该用这个，
# 因为云端连不到你本机的 MySQL、别人的电脑上也没装 MySQL）。
# 本地想用数据库管理用户时改成 "mysql"，并配好下面的 [mysql] 段。
[storage]
backend = "json"

# 本地 MySQL（可选，只有 [storage] backend = "mysql" 时才连）。
# 建库建表：先填好下面的 password，再执行 python scripts/init_db.py
# 连不上时应用不会崩，会自动回退到文件存储并在页面上提示。
[mysql]
host = "127.0.0.1"
port = 3306
user = "root"
password = "REPLACE_WITH_MYSQL_PASSWORD"
database = "pop_music"

# 歌手照片的官方图源（可选）——不配置时自动改用网易云免密钥接口取图。
# 免费获取：https://developer.spotify.com/dashboard → Create app，
# Web API 类型即可，把 Client ID 与 Client Secret 填到下面两行。
# 客户端密钥属于机密：本文件已 gitignore；Streamlit Cloud 填到 Settings → Secrets。
[spotify]
client_id = "REPLACE_WITH_SPOTIFY_CLIENT_ID"
client_secret = "REPLACE_WITH_SPOTIFY_CLIENT_SECRET"
