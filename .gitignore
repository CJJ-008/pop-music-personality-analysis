# ---- 数据文件（体积大、可重新获取；下载方法见 data/README.md）----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- 凭据与环境（仓库是公开的，绝不能提交任何密码或密钥）----
.env
kaggle.json
.streamlit/secrets.toml

# 注册用户的密码哈希（bcrypt）与用户信息，属于运行时数据
data/users.json

# ---- ZCode 本地工作文件 ----
.zcode/

# ---- 大型二进制输出 ----
# outputs/models/ 中的流行度模型（11MB）需入库：云端部署与 exe 都要加载它

# ---- PyInstaller 打包产物 ----
# exe 体积超过 GitHub 单文件 100MB 限制，且属可再生成物，不入库
build/
dist/
发布包/
